@model IReadOnlyList<StanTrack.Models.Event>
@{
    ViewData["Title"] = "Upcoming Events";
    var total = (int)ViewBag.Total;
    var shown = Model.Count;
    var hasMore = (bool)ViewBag.HasMore;
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="dash-hero__title">Upcoming events</h1>
        <p class="dash-hero__sub"><span data-event-shown>@shown</span> of @total events across all tracked celebrities.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No upcoming events yet.</p>
            <p style="font-size: var(--text-sm);">Events sync automatically every 24 hours from Ticketmaster, TMDb, and MusicBrainz.</p>
        </div>
    }
    else
    {
        <ul class="event-list"
            role="list"
            id="event-list"
            data-partial-url="@Url.Action("ListPartial", "Events")"
            data-total="@total">
            <partial name="_EventListItems" model="Model" />
        </ul>

        @if (hasMore)
        {
            <div class="text-center mt-5" id="grid-end">
                <button type="button"
                        class="btn-follow btn"
                        data-load-more
                        data-target="#event-list"
                        data-next-page="2">
                    Load more events
                </button>
                <p class="mt-2" style="font-size: var(--text-xs); color: var(--color-neutral);">
                    <span data-event-shown>@shown</span> of @total shown
                </p>
            </div>
        }
    }
</div>
