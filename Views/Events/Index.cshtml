@model IReadOnlyList<StanTrack.Models.Event>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container py-5">
    <div class="mb-5">
        <h1 class="dash-hero__title">Upcoming events</h1>
        <p class="dash-hero__sub">Showing @ViewBag.Shown of @ViewBag.Total events across all tracked celebrities.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No upcoming events yet.</p>
            <p style="font-size: var(--text-sm);">Events sync automatically every 24 hours from Ticketmaster, TMDb, and MusicBrainz.</p>
        </div>
    }
    else
    {
        <ul class="event-list" role="list">
            @foreach (var ev in Model)
            {
                var typeClass = ev.EventType switch
                {
                    StanTrack.Models.Enums.EventType.Concert => "ticker__type--concert",
                    StanTrack.Models.Enums.EventType.AlbumRelease => "ticker__type--album",
                    StanTrack.Models.Enums.EventType.MovieRelease => "ticker__type--movie",
                    StanTrack.Models.Enums.EventType.Birthday => "ticker__type--birthday",
                    _ => "ticker__type--other"
                };
                <li class="event-list__item">
                    <span class="event-list__date">@ev.EventDate.ToString("MMM dd, yyyy")</span>
                    <span>
                        <span class="event-list__title">@ev.Title</span>
                        <span class="event-list__celeb"> — @ev.Celebrity?.Name</span>
                    </span>
                    <span class="event-list__type @typeClass">@ev.EventType.GetDisplayName()</span>
                </li>
            }
        </ul>

        @if ((bool)ViewBag.HasMore)
        {
            <div class="text-center mt-5" id="grid-end">
                <a asp-action="Index"
                   asp-route-page="@ViewBag.NextPage"
                   asp-fragment="grid-end"
                   class="btn-follow btn">
                    Load more events
                </a>
                <p class="mt-2" style="font-size: var(--text-xs); color: var(--color-neutral);">
                    @ViewBag.Shown of @ViewBag.Total shown
                </p>
            </div>
        }
    }
</div>