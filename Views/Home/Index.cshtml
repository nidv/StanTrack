@model IReadOnlyList<StanTrack.Models.Event>
@{
    ViewData["Title"] = "Home";
    var featured = ViewBag.FeaturedCelebrities as IReadOnlyList<StanTrack.Models.Celebrity> ?? new List<StanTrack.Models.Celebrity>();
    var eventCount = (int)(ViewBag.EventCount ?? 0);
}

<section class="hero-stat">
    @if (eventCount > 0)
    {
        <p class="hero-stat__figure">Stan your celebs</p>
        <p class="hero-stat__label">@eventCount+ upcoming events tracked</p>
    }
    else
    {
        <p class="hero-stat__label" style="font-family: var(--font-display); font-weight: 800; font-size: var(--text-display-s); max-width: 20ch; letter-spacing: -0.03em;">Every concert, premiere, and album drop — tracked.</p>
    }
    <div class="mt-3">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a class="hero-stat__cta" asp-area="Identity" asp-page="/Account/Register">Start tracking</a>
        }
        else
        {
            <a class="hero-stat__cta" asp-controller="Events" asp-action="Index">See all events</a>
        }
    </div>
</section>

@if (Model.Count > 0)
{
    <section class="ticker" aria-label="Upcoming events">
        <div class="ticker__mask ticker__mask--top"></div>
        <p class="ticker__label">Now tracking &mdash; upcoming</p>
        <div class="ticker__track" id="tickerTrack">
            @{
                var items = Model.ToList();
            }
            @foreach (var ev in items)
            {
                var typeClass = ev.EventType switch
                {
                    StanTrack.Models.Enums.EventType.Concert => "ticker__type--concert",
                    StanTrack.Models.Enums.EventType.AlbumRelease => "ticker__type--album",
                    StanTrack.Models.Enums.EventType.MovieRelease => "ticker__type--movie",
                    StanTrack.Models.Enums.EventType.Birthday => "ticker__type--birthday",
                    _ => "ticker__type--other"
                };
                <div class="ticker__item">
                    <span class="ticker__date">@ev.EventDate.ToString("MMM dd, yyyy")</span>
                    <span class="ticker__celeb">@ev.Celebrity?.Name</span>
                    <span class="ticker__event">@ev.Title</span>
                    <span class="ticker__type @typeClass">@ev.EventType.GetDisplayName()</span>
                </div>
            }
            @* Duplicate for seamless loop *@
            @foreach (var ev in items)
            {
                var typeClass = ev.EventType switch
                {
                    StanTrack.Models.Enums.EventType.Concert => "ticker__type--concert",
                    StanTrack.Models.Enums.EventType.AlbumRelease => "ticker__type--album",
                    StanTrack.Models.Enums.EventType.MovieRelease => "ticker__type--movie",
                    StanTrack.Models.Enums.EventType.Birthday => "ticker__type--birthday",
                    _ => "ticker__type--other"
                };
                <div class="ticker__item" aria-hidden="true">
                    <span class="ticker__date">@ev.EventDate.ToString("MMM dd, yyyy")</span>
                    <span class="ticker__celeb">@ev.Celebrity?.Name</span>
                    <span class="ticker__event">@ev.Title</span>
                    <span class="ticker__type @typeClass">@ev.EventType.GetDisplayName()</span>
                </div>
            }
        </div>
        <div class="ticker__mask ticker__mask--bottom"></div>
    </section>
}

@if (featured.Count > 0)
{
    <section class="container py-5">
        <h2 class="section-label">Featured celebrities</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @for (var i = 0; i < featured.Count; i++)
            {
                <div class="col reveal" style="--i: @i">
                    <partial name="_CelebrityCard" model="featured[i]" />
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Celebrities" asp-action="Index" class="hero-stat__cta">Browse all celebrities</a>
        </div>
    </section>
}
