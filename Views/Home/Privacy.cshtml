@{
    ViewData["Title"] = "Privacy";
}

<div class="container py-5" style="max-width: 720px;">
    <h1 class="detail-hero__name mb-4">Privacy</h1>
    <p class="dash-hero__sub">StanTrack stores your email address and a record of which celebrities you follow. We do not share your data with third parties. Unfollowing a celebrity removes the association immediately. Deleting your account removes all personal data.</p>
    <p class="mt-4" style="color: var(--color-muted); font-size: var(--text-sm);">Event data is fetched from public APIs (Ticketmaster, TMDb, MusicBrainz) and refreshed once a week. Celebrity information is sourced from Wikidata under CC0.</p>
</div>