@model StanTrack.Models.Celebrity
@{
    ViewData["Title"] = Model.Name;
    var upcomingEvents = ViewBag.UpcomingEvents as IReadOnlyList<StanTrack.Models.Event> ?? Array.Empty<StanTrack.Models.Event>();
    var isFollowing = ViewBag.IsFollowing as bool? ?? false;
}

<div class="container py-5">
    <div class="detail-hero d-flex justify-content-between align-items-start mb-5">
        <div>
            <h1 class="detail-hero__name">@Model.Name</h1>
            <p class="detail-hero__meta">@Model.Category</p>
        </div>
        <div class="d-flex gap-2 pt-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Follow" asp-action="Toggle" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="celebrityId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-follow @(isFollowing ? "btn-following" : "")">
                        @(isFollowing ? "Unfollow" : "Follow")
                    </button>
                </form>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-primary">Delete</a>
            }
        </div>
    </div>

    <div class="row mb-5">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <div class="col-md-3 mb-3">
                <img src="@Model.PhotoUrl" alt="@Model.Name" class="img-fluid rounded" />
            </div>
        }
        <div class="col-md">
            @if (Model.DateOfBirth.HasValue)
            {
                <p style="color: var(--color-muted); font-size: var(--text-sm);">
                    Born / Formed: @Model.DateOfBirth.Value.ToString("MMMM d, yyyy")
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p>@Model.Bio</p>
            }
        </div>
    </div>

    <section>
        <h2 class="section-label">Upcoming events</h2>
        @if (upcomingEvents.Count == 0)
        {
            <div class="empty-state">
                <p>No upcoming events for @Model.Name yet.</p>
                <p style="font-size: var(--text-sm);">Events sync automatically every 24 hours.</p>
            </div>
        }
        else
        {
            <ul class="event-list" role="list">
                @foreach (var ev in upcomingEvents)
                {
                    var typeClass = ev.EventType switch
                    {
                        StanTrack.Models.Enums.EventType.Concert => "ticker__type--concert",
                        StanTrack.Models.Enums.EventType.AlbumRelease => "ticker__type--album",
                        StanTrack.Models.Enums.EventType.MovieRelease => "ticker__type--movie",
                        StanTrack.Models.Enums.EventType.Birthday => "ticker__type--birthday",
                        _ => "ticker__type--other"
                    };
                    <li class="event-list__item">
                        <span class="event-list__date">@ev.EventDate.ToString("MMM dd, yyyy")</span>
                        <span>
                            <span class="event-list__title">@ev.Title</span>
                            @{
                                var location = StanTrack.Models.EventLocation.Format(ev);
                            }
                            @if (!string.IsNullOrEmpty(location))
                            {
                                <span class="event-list__location">@location</span>
                            }
                        </span>
                        <span class="event-list__type @typeClass">@ev.EventType.GetDisplayName()</span>
                    </li>
                }
            </ul>
        }
    </section>
</div>