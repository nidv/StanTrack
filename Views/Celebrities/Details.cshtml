@model StanTrack.Models.Celebrity
@{
    ViewData["Title"] = Model.Name;
    var upcomingEvents = ViewBag.UpcomingEvents as IReadOnlyList<StanTrack.Models.Event> ?? Array.Empty<StanTrack.Models.Event>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@Model.Name</h1>
    <div class="d-flex gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var isFollowing = ViewBag.IsFollowing as bool? ?? false;
            <form asp-controller="Follow" asp-action="Toggle" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="celebrityId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <button type="submit" class="btn @(isFollowing ? "btn-outline-danger" : "btn-primary")">
                    @(isFollowing ? "Unfollow" : "Follow")
                </button>
            </form>
        }
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        }
    </div>
</div>

<div class="row mb-4">
    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
    {
        <div class="col-md-3 mb-3">
            <img src="@Model.PhotoUrl" alt="@Model.Name" class="img-fluid rounded" />
        </div>
    }
    <div class="col-md">
        <dl class="row">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            @if (Model.DateOfBirth.HasValue)
            {
                <dt class="col-sm-3">Born / Formed</dt>
                <dd class="col-sm-9">@Model.DateOfBirth.Value.ToString("MMMM d, yyyy")</dd>
            }

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <dt class="col-sm-3">Bio</dt>
                <dd class="col-sm-9">@Model.Bio</dd>
            }
        </dl>
    </div>
</div>

<h2 class="h4">Upcoming Events</h2>
@if (upcomingEvents.Count == 0)
{
    <p class="text-muted">No upcoming events.</p>
}
else
{
    <ul class="list-group">
        @foreach (var ev in upcomingEvents)
        {
            <li class="list-group-item">
                <strong>@ev.Title</strong>
                <span class="badge bg-secondary ms-2">@ev.EventType.GetDisplayName()</span>
                <span class="text-muted ms-2">@ev.EventDate.ToString("yyyy-MM-dd")</span>
            </li>
        }
    </ul>
}
