@using System
@model StanTrack.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (Model.FollowedCelebrities.Count == 0)
{
    <div class="empty-state">
        <p>You're not following any celebrities yet.</p>
        <a asp-controller="Celebrities" asp-action="Index" class="hero-stat__cta">Browse celebrities</a>
    </div>
}
else
{
    <div class="dash-split">
        <section>
            <h2 class="section-label">Following (@Model.FollowedCelebrities.Count)</h2>
            <div class="mini-grid">
                @foreach (var celeb in Model.FollowedCelebrities)
                {
                    var initials = string.Join("", celeb.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
                    if (initials.Length > 2) initials = initials[..2];

                    <div class="mini-card">
                        <a asp-controller="Celebrities" asp-action="Details" asp-route-id="@celeb.Id"
                           class="mini-card__link text-decoration-none text-reset">
                            @if (!string.IsNullOrEmpty(celeb.PhotoUrl))
                            {
                                <img src="@celeb.PhotoUrl" alt="@celeb.Name" class="mini-card__img" />
                            }
                            else
                            {
                                <div class="mini-card__img mini-card__img--initials">@initials</div>
                            }
                            <span class="mini-card__name">@celeb.Name</span>
                        </a>
                        <form asp-controller="Follow" asp-action="Toggle" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="celebrityId" value="@celeb.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="mini-card__unfollow">Unfollow</button>
                        </form>
                    </div>
                }
            </div>
        </section>

        <section>
            <h2 class="section-label">Upcoming events</h2>
            @if (Model.UpcomingEvents.Count == 0)
            {
                <div class="empty-state" style="padding: var(--space-xl) var(--space-sm);">
                    <p>No upcoming events yet.</p>
                    <p style="font-size: var(--text-xs);">Events sync every 24 hours.</p>
                </div>
            }
            else
            {
                <ul class="event-list" role="list">
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        var typeClass = ev.EventType switch
                        {
                            StanTrack.Models.Enums.EventType.Concert => "ticker__type--concert",
                            StanTrack.Models.Enums.EventType.AlbumRelease => "ticker__type--album",
                            StanTrack.Models.Enums.EventType.MovieRelease => "ticker__type--movie",
                            StanTrack.Models.Enums.EventType.Birthday => "ticker__type--birthday",
                            _ => "ticker__type--other"
                        };
                        <li class="event-list__item">
                            <span class="event-list__date">@ev.EventDate.ToString("MMM dd, yyyy")</span>
                            <span>
                                <span class="event-list__title">@ev.Title</span>
                                <span class="event-list__celeb"> — @ev.Celebrity?.Name</span>
                                @{
                                    var location = StanTrack.Models.EventLocation.Format(ev);
                                }
                                @if (!string.IsNullOrEmpty(location))
                                {
                                    <span class="event-list__location">@location</span>
                                }
                            </span>
                            <span class="event-list__type @typeClass">@ev.EventType.GetDisplayName()</span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
}