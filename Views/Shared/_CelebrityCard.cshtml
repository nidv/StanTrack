@model StanTrack.Models.Celebrity
@{
    var followedIds = ViewData["FollowedCelebrityIds"] as HashSet<int> ?? new HashSet<int>();
    var isFollowing = followedIds.Contains(Model.Id);
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var initials = string.Join("", Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
    if (initials.Length > 2) initials = initials[..2];
}

<div class="card h-100 card-clickable position-relative">
    <a asp-controller="Celebrities" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link text-decoration-none text-reset">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" class="card-img-top" alt="@Model.Name" style="object-fit:cover; object-position:center 20%; max-height:280px;" />
        }
        else
        {
            <div class="card-img-top d-flex align-items-center justify-content-center" style="height:220px; background: var(--color-paper-2); font-family: var(--font-display); font-weight: 800; font-size: var(--text-3xl); color: var(--color-neutral);">
                @initials
            </div>
        }
        <div class="card-body d-flex flex-column">
            <h5 class="card-title">@Model.Name</h5>
            <p class="card-text mb-3" style="font-size: var(--text-sm);">@Model.Category</p>
        </div>
    </a>
    <div class="card-body pt-0 position-relative" style="z-index: 2;">
        <div class="d-flex flex-wrap gap-1">
            @if (isSignedIn)
            {
                <form asp-controller="Follow" asp-action="Toggle" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="celebrityId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-sm btn-follow @(isFollowing ? "btn-following" : "")">
                        @(isFollowing ? "Unfollow" : "Follow")
                    </button>
                </form>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Celebrities" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                <a asp-controller="Celebrities" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Delete</a>
            }
        </div>
    </div>
</div>